# Use official Python 3.12 slim image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Copy your code and tests
COPY ros2_code ./ros2_code
COPY tests ./tests
COPY tests/pytest.ini ./pytest.ini
# Install dependencies
RUN apt-get update && apt-get install -y \
        build-essential \
        cmake \
        git \
        curl \
        libpython3-dev \
        && rm -rf /var/lib/apt/lists/*

# Install Python packages: pytest, numpy
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir pytest numpy

# Set PYTHONPATH so pytest can find ros2_code
ENV PYTHONPATH=/app

# Default command: run pytest on the tests folder
CMD ["python3", "-m", "pytest", "-v", "--disable-warnings", "tests"]
