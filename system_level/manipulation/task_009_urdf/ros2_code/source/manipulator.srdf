<?xml version="1.0" ?>
<robot name="manipulator">

  <!-- ==================== Planning Groups ==================== -->

  <!-- Arm group: defined as a kinematic chain for IK solvers -->
  <group name="arm">
    <chain base_link="base_link" tip_link="link6"/>
  </group>

  <!-- Gripper group: defined by individual joints -->
  <group name="gripper">
    <joint name="f_joint1"/>
    <joint name="f_joint2"/>
  </group>

  <!-- ==================== Group States (Named Poses) ==================== -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="f_joint1" value="0.04"/>
    <joint name="f_joint2" value="0.04"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="f_joint1" value="0"/>
    <joint name="f_joint2" value="0"/>
  </group_state>

  <!-- ==================== End Effector ==================== -->
  <end_effector name="gripper_ee" parent_link="link6" group="gripper"/>

  <!-- ==================== Allowed Collision Matrix (ACM) ==================== -->
  <!-- Adjacent link pairs: disable collision checking between them -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="f_link1" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="f_link2" reason="Adjacent"/>

  <!-- Non-adjacent but never-in-collision pairs -->
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="f_link1" link2="f_link2" reason="Never"/>

</robot>